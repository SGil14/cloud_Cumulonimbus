# Copiar como .env y completar. NUNCA versionar el .env real.

# Conexión a PostgreSQL (driver psycopg 3)
DATABASE_URL=postgresql+psycopg://usuario:password@localhost:5432/lluvia_bogota

# Segundos que se reutilizan los datos del SAB antes de volver a consultarlo
CACHE_ESTACIONES_SEGUNDOS=90

# Una lectura más vieja que esto se marca como desactualizada y no cuenta como lluvia
MINUTOS_LECTURA_VIEJA=30

# Cuántas estaciones cercanas mostrar al consultar un destino
ESTACIONES_CERCANAS=3

# Recolector del histórico (guarda las lecturas del SAB cada N minutos)
RECOLECTOR_ACTIVO=true
RECOLECTOR_INTERVALO_MINUTOS=5

# Orígenes permitidos para el front en desarrollo (formato JSON)
CORS_ORIGINS=["http://localhost:5173"]

LOG_LEVEL=INFO

# Geocodificador oficial IDECA (gratuito; pedir la API key a IDECA / Catastro Bogotá).
# Sin clave, el buscador usa solo Nominatim (OpenStreetMap).
IDECA_API_KEY=

# Servicio de rutas (Valhalla, gratuito de OpenStreetMap). Cambiar solo si se usa otra instancia.
# RUTA_URL=https://valhalla1.openstreetmap.de/route

# Solo para Docker (docker compose): contraseña de la base PostgreSQL que crea el contenedor.
# Usa solo letras y números (se arma una URL con ella).
# POSTGRES_PASSWORD=
